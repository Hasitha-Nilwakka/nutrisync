#PostgreSQL configuration
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=nutrisync

# Application database connection
DATABASE_URL=postgresql://username:password@db:5432/nutrisync?schema=public

# Verification credentials
EMAIL_USER=nutrisyncemail@gmail.com
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
EMAIL_APP_PASSWORD=app_password

#App url
APP_URL=http://localhost:3000

#secret for signing access token
ACCESS_TOKEN_SECRET="paste-your-generated-secret-here"

NODE_ENV="development"