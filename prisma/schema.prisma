generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * User table
 */
/**
 * Stores the GDPR concent, verification token and if the user has verified the email
 */
model User {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String    @unique
  password                   String
  concented                  Boolean
  verified                   Boolean   @default(false)
  verifiedAt                 DateTime?
  verificationToken          String?
  verificationTokenExpiredAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  sessions     Session[]
  resetAttemps PasswordReset[]
}

//stores the user session, token hash also store the rotation
model Session {
  id     String @id @default(cuid())
  userId String @db.Uuid

  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastRotatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  @@index([userId, expiresAt])
}

//refresh tokens for sessions
model RefreshToken {
  id        String @id @default(cuid())
  sessionId String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
}

//password reset verifications
model PasswordReset {
  id                      String    @id @default(cuid())
  userId                  String    @db.Uuid
  createdAt               DateTime  @default(now())
  verificationToken       String
  verificationTokenExpiry DateTime
  verified                Boolean   @default(false)
  revokedAt               DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
